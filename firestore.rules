rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isMain() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'main';
    }

    // Admin list: only the main admin can change it. Each admin can read their own document.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isMain());
      allow write: if isMain();
    }

    match /staff/{id}      { allow read, write: if isAdmin(); }
    match /lists/{id}      { allow read, write: if isAdmin(); }
    match /attendance/{id} { allow read, write: if isAdmin(); }
    match /jobs/{id} {
      allow read, write: if isAdmin();
      match /photos/{pid} { allow read, write: if isAdmin(); }
    }
  }
}
